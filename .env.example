# Copie para .env e preencha.
# Chave longa e aleatória (ex.: gere com: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=
# Primeiro administrador (criado na primeira vez que o servidor sobe)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
# Banco: deixe vazio para usar o Postgres do docker-compose.
# Para o Supabase: Project Settings > Database > Connection string (URI), trocando o início por postgresql+psycopg://
DATABASE_URL=
# Schema das tabelas no Postgres. Use "fenotipagem" para dividir o projeto Supabase com o INOVAAGRO sem misturar tabelas.
DB_SCHEMA=
# Lado maior da imagem mostrada no mapa (px)
PREVIEW_MAX_PX=4096
